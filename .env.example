# ─── Apollo GraphOS ───────────────────────────────────────────────────────────
# Personal API key — required for sync-reviewers (service keys can't list org members)
# Also what rover uses for subgraph check and publish, so it needs Contributor+.
#
# TWO KEYS, DIFFERENT ROLES. Do not collapse them — the split is the point:
# the agent's MCP key (GRAPHOS_API_KEY, below) physically cannot publish.
#   APOLLO_KEY       write path — rover check/publish, sync-reviewers
#   GRAPHOS_API_KEY  read path  — graphos-tools MCP server, Observer only
#
# Get from: https://studio.apollographql.com/user-settings/api-keys
APOLLO_KEY=user:gh.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxx

# Graph ID (not the ref). Visible in Studio → Graph Settings.
APOLLO_GRAPH_ID=your-graph-id

# Graph ref: <graph-id>@<variant>. Use a dev/staging variant, not main prod.
APOLLO_GRAPH_REF=your-graph-id@dev

# ─── GraphOS MCP server (.mcp.json) ───────────────────────────────────────────
# Read-only key for https://mcp.apollographql.com — used as the x-api-key header.
# Use an Observer-role GRAPH API key (service:...), NOT a personal user: key,
# and NOT the same key as APOLLO_KEY above. Observer cannot publish — that is
# the guardrail the connectors demo demonstrates.
# Studio -> Graph Settings -> API Keys -> Add key -> role: Observer
GRAPHOS_API_KEY=service:your-graph-id:xxxxxxxxxxxxxxxxxxxxxx

# ─── Subgraph routing URLs ────────────────────────────────────────────────────
# Where subgraphs are reachable FROM the router (or from CI for rover publish).
# For local dev these point to localhost. For deployed demo, use public URLs.
PRODUCTS_SUBGRAPH_URL=http://localhost:4001/products/graphql
ORDERS_SUBGRAPH_URL=http://localhost:4001/orders/graphql
